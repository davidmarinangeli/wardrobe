node_modules/
dist/
.DS_Store
.env
.env.*
!.env.example
*.log
data/
# Private Google OAuth connection and future sync-control state. This rule also
# covers custom WARDROBE_DATA_DIR values inside the repository.
.google-drive/

# Runtime cache (WARDROBE_CACHE_DIR, default .cache): the background-removal
# model under transformers/ and the drape portrait under drapes/, a crop of a
# personal reference photo. Everything in it regenerates itself.
.cache/

# Legacy location of the drape portrait. Nothing writes here any more (it moved
# to .cache/drapes/), but older checkouts still have a personal crop in it, so
# it stays ignored. Delete the folder by hand: `vite build` would copy it to dist/.
public/drapes/

# Source screen recordings for the README. These are hundreds of MB each and
# GitHub rejects anything over 100MB — only the transcoded MP4s and their
# poster frames in docs/screenshots/ belong in the repo.
docs/screenshots/*.gif
docs/screenshots/*.mov

# JetBrains project files — local IDE state, including machine paths.
.idea/

# Local model/face reference photos — personal, never committed (the app reads
# its references from data/, which is ignored above).
/face-ref.png
/model-ref.png
