# Which AI backend runs the import pipeline: "openai" (default), "gemini", or "minimax".
AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high

# Used when AI_PROVIDER=gemini. The app has a TEST/PROD toggle in its header that picks which
# key below is used, without a restart. Point GEMINI_API_KEY_TEST at a key from a Google Cloud
# project with NO billing account linked — that key physically cannot be charged, so it's safe
# for everyday development. Get a free key at https://aistudio.google.com/apikey (make sure the
# project you pick there has no billing account attached). Point GEMINI_API_KEY_PROD at your
# billed key, used only when you deliberately switch to PROD mode.
GEMINI_API_KEY_TEST=
GEMINI_API_KEY_PROD=
# Legacy fallback: used as the PROD key if GEMINI_API_KEY_PROD is not set.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.6-flash
# gemini-2.5-flash-image (default) has a free tier (500 images/day). Used for garment cutouts
# and for the "standard" tier when generating a model photo.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_IMAGE_SIZE=1K
# Used for the "premium" tier when generating a model photo (the Generate button on a wardrobe
# item/outfit lets you pick standard vs premium at that moment). gemini-3.1-flash-image is
# "Nano Banana 2" — costs a small amount per image (~$0.067 at 1K) but is higher quality.
# Requires billing, so the app only allows this tier in PROD mode.
GEMINI_MODELED_PREMIUM_MODEL=gemini-3.1-flash-image
# Model for outfit suggestions (text-only, structured output). Free tier in both TEST and PROD.
GEMINI_SUGGESTIONS_MODEL=gemini-3.6-flash

# Used when AI_PROVIDER=minimax. Global endpoint by default; use https://api.minimaxi.com/v1
# for the China endpoint. No test/prod key split — that's a Gemini-specific concept.
MINIMAX_API_KEY=
MINIMAX_API_BASE_URL=https://api.minimax.io/v1
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_IMAGE_RESPONSE_FORMAT=base64
MINIMAX_IMAGE_ASPECT_RATIO=
MINIMAX_PROMPT_OPTIMIZER=false
MINIMAX_IMAGE_SEED=

# Add a PNG at data/model-reference.png or point to another local file.
WARDROBE_MODEL_REFERENCE=data/model-reference.png
# Optional: a tight close-up of the same person's face and shoulders (head filling most of the
# frame). The full-body reference above usually leaves the face as a tiny sliver of pixels, which
# is often the real bottleneck for consistent identity across generations — this gives the model
# far more facial detail to anchor to on every generation. Silently ignored if the file is absent.
WARDROBE_FACE_REFERENCE=data/model-reference-face.png
