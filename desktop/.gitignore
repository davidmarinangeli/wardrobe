node_modules/
# Control-panel build output (bundled into the app by `tauri build`).
dist/
# Downloaded Node archives (fetch-node.mjs).
.cache/
# Rust build output and generated capability schemas.
src-tauri/target/
src-tauri/gen/
# Generated by scripts/prepare.mjs: the Node sidecar binary, the server
# bundle with its native modules, and the copy of the web app.
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep
src-tauri/resources/*
!src-tauri/resources/.gitkeep
# Temporary bundles from test/scripts.test.mjs.
.test-bundle-*/
# Command permissions tauri-build regenerates from build.rs on every build.
src-tauri/permissions/autogenerated/
